# ===============================
# LLM / Explorer Configuration
# ===============================
# API keys for various LLM providers (REQUIRED for exploration)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# HuggingFace Inference API (for AgentTrek with LLaMA)
HUGGINGFACE_API_KEY=your-huggingface-token-here

# ===============================
# 🔄 CHUYỂN ĐỔI MODEL: Chỉ cần đóng/mở comment 1 trong 2 section dưới
# ===============================

# ===== OPTION 1: SỬ DỤNG OPENAI (GPT-4) ===== 
# Bỏ comment các dòng dưới để dùng OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=${OPENAI_API_KEY}

# EXPLORER_PROVIDER=agenttrek
# EXPLORER_MODEL=gpt-4o
# EXPLORER_BASE_URL=https://api.openai.com/v1
# EXPLORER_API_KEY=${OPENAI_API_KEY}

# ===== OPTION 2: SỬ DỤNG LLAMA (HuggingFace) ===== 
# Bỏ comment các dòng dưới để dùng LLaMA (DEFAULT)
LLM_PROVIDER=llama
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
OPENAI_MODEL=gpt-4o-mini
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=${HUGGINGFACE_API_KEY}

EXPLORER_PROVIDER=agenttrek
EXPLORER_MODEL=meta-llama/Llama-3.1-8B-Instruct
EXPLORER_BASE_URL=https://router.huggingface.co/v1
EXPLORER_API_KEY=${HUGGINGFACE_API_KEY}

# ===== COMMON SETTINGS (Dùng chung cho cả 2) =====
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
EXPLORER_TEMPERATURE=0.2
EXPLORER_MAX_STEPS=50

# ===============================
# Browser / Playwright
# ===============================
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# ===============================
# Paths
# ===============================
DATA_DIR=data
RAW_DATA_DIR=data/raw
TRAJECTORY_DIR=data/trajectories
CHECKPOINT_DIR=checkpoints

# ===============================
# Training / SLM
# ===============================
SLM_DEVICE=cpu
SLM_DTYPE=float32
SLM_MAX_SEQ_LEN=2048

# ===============================
# Evaluation
# ===============================
EVAL_MAX_EPISODES=20
EVAL_DETERMINISTIC=true

# ===============================
# Logging
# ===============================
LOG_LEVEL=INFO
